<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_facturasend_connector_tree" model="ir.ui.view">
        <field name="name">l10n_py.edi.connector.facturasend.tree</field>
        <field name="model">l10n_py.edi.connector.facturasend</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="company_id" />
                <field name="environment" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="view_facturasend_connector_form" model="ir.ui.view">
        <field name="name">l10n_py.edi.connector.facturasend.form</field>
        <field name="model">l10n_py.edi.connector.facturasend</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="test_connection"
                            string="Probar Conexión"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-plug"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="environment" />
                            <field name="base_url" readonly="1" />
                            <field name="timeout" />
                        </group>
                    </group>
                    <group string="Credenciales">
                        <field name="api_key" password="True" />
                        <field name="tenant_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_facturasend_connector" model="ir.actions.act_window">
        <field name="name">Conectores FacturaSend</field>
        <field name="res_model">l10n_py.edi.connector.facturasend</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'default_company_id': context.get('company_id')}</field>
    </record>
</odoo>
