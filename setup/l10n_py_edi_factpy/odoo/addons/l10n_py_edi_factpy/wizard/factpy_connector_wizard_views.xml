<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <!-- FactPy Setup Wizard Form -->
        <record id="view_factpy_setup_wizard_form" model="ir.ui.view">
            <field name="name">factpy.setup.wizard.form</field>
            <field name="model">factpy.setup.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>Configuración de FactPy</h1>
                            <p>Configure las credenciales para conectar con FactPy</p>
                        </div>
                        <group>
                            <field name="name" />
                            <field name="environment" />
                        </group>
                        <group>
                            <field name="api_key" password="True" />
                            <field name="api_secret" password="True" />
                        </group>
                        <footer>
                            <button
                            name="action_create_connector"
                            type="object"
                            string="Crear Conector"
                            class="btn-primary"
                        />
                            <button special="cancel" string="Cancelar" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- FactPy Setup Wizard Action -->
        <record id="action_factpy_setup_wizard" model="ir.actions.act_window">
            <field name="name">Configurar FactPy</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">factpy.setup.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_environment': 'test'}</field>
        </record>
</odoo>
