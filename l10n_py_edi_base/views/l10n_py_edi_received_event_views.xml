<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_py_edi_received_event_form" model="ir.ui.view">
        <field name="name">l10n_py.edi.received.event.form</field>
        <field name="model">l10n_py.edi.received.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_send_receiver_event"
                        string="Enviar al SIFEN"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_reset_to_draft"
                        string="Reenviar"
                        type="object"
                        invisible="state not in ('rejected', 'error')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,to_send,sent,accepted"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_type" readonly="state != 'draft'" />
                            <field name="cdc" readonly="state != 'draft'" />
                            <field name="move_id" />
                            <field name="partner_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field
                                name="tipo_receptor"
                                invisible="event_type not in ('desconocimiento', 'notificacion_recepcion')"
                                required="event_type in ('desconocimiento', 'notificacion_recepcion')"
                            />
                            <field
                                name="tipo_conformidad"
                                invisible="event_type != 'conformidad'"
                                required="event_type == 'conformidad'"
                            />
                            <field
                                name="fecha_emision_dte"
                                invisible="event_type not in ('desconocimiento', 'notificacion_recepcion')"
                                required="event_type in ('desconocimiento', 'notificacion_recepcion')"
                            />
                            <field
                                name="fecha_recepcion"
                                invisible="event_type == 'disconformidad'"
                                required="event_type in ('desconocimiento', 'notificacion_recepcion')"
                            />
                            <field
                                name="total_gs"
                                invisible="event_type != 'notificacion_recepcion'"
                                required="event_type == 'notificacion_recepcion'"
                            />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                    <group
                        invisible="event_type not in ('disconformidad', 'desconocimiento')"
                    >
                        <field
                            name="motivo"
                            required="event_type in ('disconformidad', 'desconocimiento')"
                        />
                    </group>
                    <group string="Resultado SIFEN">
                        <field name="protocolo_sifen" readonly="1" />
                        <field name="error_message" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Logs EDI" name="edi_logs">
                            <field name="edi_log_ids" readonly="1">
                                <list>
                                    <field name="create_date" />
                                    <field name="operation_type" />
                                    <field name="provider" />
                                    <field name="success" />
                                    <field name="error_message" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_py_edi_received_event_tree" model="ir.ui.view">
        <field name="name">l10n_py.edi.received.event.list</field>
        <field name="model">l10n_py.edi.received.event</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state=='accepted'"
                decoration-danger="state in ('rejected', 'error')"
                decoration-info="state in ('to_send', 'sent')"
            >
                <field name="cdc" />
                <field name="partner_id" />
                <field name="event_type" />
                <field name="state" widget="badge" />
                <field name="protocolo_sifen" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="view_l10n_py_edi_received_event_search" model="ir.ui.view">
        <field name="name">l10n_py.edi.received.event.search</field>
        <field name="model">l10n_py.edi.received.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="cdc" />
                <field name="partner_id" />
                <field name="move_id" />
                <filter
                    string="Notificación de Recepción"
                    name="filter_notificacion_recepcion"
                    domain="[('event_type', '=', 'notificacion_recepcion')]"
                />
                <filter
                    string="Conformidad"
                    name="filter_conformidad"
                    domain="[('event_type', '=', 'conformidad')]"
                />
                <filter
                    string="Disconformidad"
                    name="filter_disconformidad"
                    domain="[('event_type', '=', 'disconformidad')]"
                />
                <filter
                    string="Desconocimiento"
                    name="filter_desconocimiento"
                    domain="[('event_type', '=', 'desconocimiento')]"
                />
                <separator />
                <filter
                    string="Borrador"
                    name="filter_draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Aceptado"
                    name="filter_accepted"
                    domain="[('state', '=', 'accepted')]"
                />
                <filter
                    string="Rechazado/Error"
                    name="filter_rejected_error"
                    domain="[('state', 'in', ('rejected', 'error'))]"
                />
                <group expand="0" string="Agrupar Por">
                    <filter
                        string="Proveedor"
                        name="group_by_partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        string="Tipo de Evento"
                        name="group_by_event_type"
                        context="{'group_by': 'event_type'}"
                    />
                    <filter
                        string="Estado"
                        name="group_by_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_py_edi_received_event" model="ir.actions.act_window">
        <field name="name">Eventos de Receptor</field>
        <field name="res_model">l10n_py.edi.received.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo evento de receptor
            </p>
            <p>
                Registre y transmita al SIFEN los eventos del lado receptor:
                Notificación de Recepción (el "acuse de recibo"), Conformidad,
                Disconformidad o Desconocimiento, referenciando el CDC de un
                DTE emitido por un proveedor.
            </p>
        </field>
    </record>
</odoo>
