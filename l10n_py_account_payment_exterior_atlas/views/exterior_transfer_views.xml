<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_py_atlas_exterior_transfer_form" model="ir.ui.view">
        <field name="name">l10n_py.atlas.exterior.transfer.form</field>
        <field name="model">l10n_py.atlas.exterior.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_validar_swift"
                        type="object"
                        string="Validar SWIFT"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_atlas_cotizar"
                        type="object"
                        string="Cotizar"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_atlas_confirmar"
                        type="object"
                        string="Confirmar"
                        class="btn-primary"
                        invisible="state != 'quoted'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group string="Origen y Destino">
                            <field name="company_bank_account_id" />
                            <field name="beneficiario_nombre" />
                            <field name="beneficiario_cuenta" />
                            <field name="beneficiario_swift" />
                            <field name="beneficiario_banco_nombre" readonly="1" />
                            <field name="beneficiario_pais" />
                            <field name="beneficiario_ciudad" />
                            <field name="beneficiario_direccion" />
                        </group>
                        <group string="Operación">
                            <field name="moneda" />
                            <field name="monto_transferencia" />
                            <field name="codigo_motivo" />
                            <field name="numero_orden_pago_dna" />
                            <field name="numero_contrato_cambio" />
                            <field name="tipo_cargo" />
                            <field name="plazo" />
                        </group>
                        <group string="Cotización" invisible="state == 'draft'">
                            <field name="numero_referencia" readonly="1" />
                            <field name="monto_cargo" readonly="1" />
                            <field name="monto_cargo_intermediario" readonly="1" />
                            <field name="monto_cargo_plazo" readonly="1" />
                            <field name="total_debito" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_l10n_py_atlas_exterior_transfer" model="ir.actions.act_window">
        <field name="name">Transferencias al Exterior (Atlas)</field>
        <field name="res_model">l10n_py.atlas.exterior.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
