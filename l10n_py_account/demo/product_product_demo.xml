<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- ============== PRODUCTOS CON IVA 10% ============== -->

    <record id="product_iva_10_electronica" model="product.product">
        <field name="company_id" ref="demo_company_py" />
        <field name="name">Notebook Dell Inspiron</field>
        <field name="categ_id" ref="product.product_category_goods" />
        <field name="type">consu</field>
        <field name="default_code">ELEC-001</field>
        <field name="list_price" eval="5500000.0" />
        <field name="standard_price" eval="4200000.0" />
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field
            name="taxes_id"
            search="[('type_tax_use', '=', 'sale'), ('tax_group_id.name', '=', 'IVA 10%'), ('company_id', '=', ref('demo_company_py'))]"
        />
        <field
            name="supplier_taxes_id"
            search="[('type_tax_use', '=', 'purchase'), ('tax_group_id.name', '=', 'IVA 10%'), ('company_id', '=', ref('demo_company_py'))]"
        />
    </record>

