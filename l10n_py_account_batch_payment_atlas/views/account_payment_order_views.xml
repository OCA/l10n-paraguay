<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_line_form_atlas" model="ir.ui.view">
        <field name="name">account.payment.line.form.atlas</field>
        <field name="model">account.payment.line</field>
        <field
            name="inherit_id"
            ref="account_payment_order.account_payment_line_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group name="atlas_info" col="2">
                    <button
                        name="action_atlas_reversar_pago"
                        type="object"
                        string="Reversar pago (Atlas)"
                        class="btn-secondary"
                        invisible="not atlas_nro_orden"
                    />
                    <field name="atlas_nro_orden" readonly="1" />
                    <field name="atlas_estado" readonly="1" />
                    <field name="atlas_error_codigo" readonly="1" />
                    <field name="atlas_error_mensaje" readonly="1" />
                    <field name="atlas_reversal_reference" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_order_form_atlas" model="ir.ui.view">
        <field name="name">account.payment.order.form.atlas</field>
        <field name="model">account.payment.order</field>
        <field
            name="inherit_id"
            ref="account_payment_order.account_payment_order_form"
        />
        <field name="arch" type="xml">
            <field name="company_partner_bank_id" position="after">
                <field name="l10n_py_atlas_tipo_transferencia" />
            </field>
        </field>
    </record>
</odoo>
