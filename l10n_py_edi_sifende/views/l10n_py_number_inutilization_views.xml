<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_py_number_inutilization_form_sifende" model="ir.ui.view">
        <field name="name">l10n_py.number.inutilization.form.sifende</field>
        <field name="model">l10n_py.number.inutilization</field>
        <field
            name="inherit_id"
            ref="l10n_py_edi_base.view_l10n_py_number_inutilization_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='authorization_id']" position="before">
                <field name="l10n_py_sifende_event_key" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='authorization_id']" position="attributes">
                <attribute name="readonly">l10n_py_sifende_event_key</attribute>
            </xpath>
            <xpath expr="//field[@name='number_from']" position="attributes">
                <attribute name="readonly">l10n_py_sifende_event_key</attribute>
            </xpath>
            <xpath expr="//field[@name='number_to']" position="attributes">
                <attribute name="readonly">l10n_py_sifende_event_key</attribute>
            </xpath>
            <xpath expr="//field[@name='motive']" position="attributes">
                <attribute name="readonly">l10n_py_sifende_event_key</attribute>
            </xpath>
        </field>
    </record>
    <menuitem
        id="menu_l10n_py_number_inutilization"
        name="Inutilización de números"
        parent="l10n_py_edi_base.menu_l10n_py_edi_root"
        action="l10n_py_edi_base.action_l10n_py_number_inutilization"
        groups="account.group_account_manager"
        sequence="30"
    />
</odoo>
