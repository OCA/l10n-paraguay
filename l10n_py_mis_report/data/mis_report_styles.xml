<odoo noupdate="1">
    <record id="mis_report_style_l10n_py_header" model="mis.report.style">
        <field name="name">PY Header</field>
        <field name="font_weight_inherit" eval="0" />
        <field name="font_weight">bold</field>
        <field name="font_size_inherit" eval="0" />
        <field name="font_size">large</field>
    </record>

    <record id="mis_report_style_l10n_py_total" model="mis.report.style">
        <field name="name">PY Total</field>
        <field name="font_weight_inherit" eval="0" />
        <field name="font_weight">bold</field>
    </record>

    <record id="mis_report_style_l10n_py_subtotal" model="mis.report.style">
        <field name="name">PY Subtotal</field>
        <field name="font_weight_inherit" eval="0" />
        <field name="font_weight">bold</field>
        <field name="font_style_inherit" eval="0" />
        <field name="font_style">italic</field>
    </record>
</odoo>
