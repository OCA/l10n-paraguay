<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_py_base_res_partner_address" model="ir.ui.view">
        <field name="name">l10n_py_base.res.partner.address</field>
        <field name="model">res.partner</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <!-- Leaving padding as 0 because it is getting unnecessary spacing -->
            <form style="padding: 0 !important;">
                <div class="o_address_format">
                    <field name="street" class="oe_read_only" invisible="1" />
                    <field
                        name="zip"
                        placeholder="Zip code..."
                        style="width: 70%"
                        class="o_address_zip"
                    />
                    <field
                        name="street_name"
                        placeholder="Street..."
                        class="o_address_street"
                    />
                    <field
                        name="street_number"
                        placeholder="Street number..."
                        class="o_address_street"
                    />
                    <field
                        name="street2"
                        placeholder="Complement..."
                        class="o_address_street"
                    />
                    <field
                        name="l10n_py_neighborhood_id"
                        placeholder="Neighborhood..."
                        class="o_address_street"
                        options='{"no_open": True, "no_create": True}'
                        invisible="country_id != %(base.py)d"
                    />
                    <field
                        name="state_id"
                        domain="[('country_id', '=', country_id)]"
                        placeholder="State..."
                        style="width: 45%"
                        class="o_address_state"
                        options='{"no_open": True, "no_create": True}'
                    />
                    <field
                        name="city_id"
                        placeholder="City..."
                        style="width: 50%"
                        class="o_address_city"
                        options='{"no_open": True, "no_create": True}'
                        invisible="country_id != %(base.py)d"
                    />
                    <field
                        name="city"
                        placeholder="City..."
                        style="width: 50%"
                        class="o_address_city"
                        force_save="True"
                        invisible="country_id == %(base.py)d"
                    />
                    <field
                        name="country_id"
                        placeholder="Country..."
                        class="o_address_country"
                        options='{"no_open": True, "no_create": True}'
                    />
                </div>
            </form>
        </field>
    </record>

    <!-- Extension of partner form view for PY fields -->
    <record id="l10n_py_base_res_partner_form" model="ir.ui.view">
        <field name="name">l10n_py_base.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <!-- Trade name after name (Odoo 19.0 structure: no oe_title) -->
            <xpath expr="//h1[field[@name='name']]" position="after">
                <field
                    name="l10n_py_fantasy_name"
                    placeholder="Trade Name..."
                    invisible="country_id != %(base.py)d"
                />
            </xpath>

            <!-- PY fiscal fields after LATAM identification field -->
            <xpath
                expr="//field[@name='l10n_latam_identification_type_id']"
                position="after"
            >
                <field
                    name="l10n_py_taxpayer_type"
                    invisible="country_id != %(base.py)d"
                />
                <field
                    name="l10n_py_activity_description"
                    invisible="country_id != %(base.py)d"
                />
            </xpath>
        </field>
    </record>
</odoo>
