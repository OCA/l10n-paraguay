<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- List View -->
    <record id="view_l10n_py_neighborhood_list" model="ir.ui.view">
        <field name="name">l10n_py.neighborhood.list</field>
        <field name="model">l10n_py.neighborhood</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="city_id" />
                <field name="state_id" />
                <field name="country_id" />
                <field name="zipcode" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_l10n_py_neighborhood_form" model="ir.ui.view">
        <field name="name">l10n_py.neighborhood.form</field>
        <field name="model">l10n_py.neighborhood</field>
        <field name="arch" type="xml">
            <form string="Neighborhood">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="zipcode" />
                        </group>
                        <group>
                            <field name="country_id" />
                            <field name="state_id" />
                            <field name="city_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_l10n_py_neighborhood_search" model="ir.ui.view">
        <field name="name">l10n_py.neighborhood.search</field>
        <field name="model">l10n_py.neighborhood</field>
        <field name="arch" type="xml">
            <search string="Neighborhoods">
                <field name="name" />
                <field name="code" />
                <field name="city_id" />
                <field name="state_id" />
                <field name="country_id" />
                <field name="zipcode" />
                <filter
                    string="By City"
                    name="group_by_city"
                    context="{'group_by': 'city_id'}"
                />
                <filter
                    string="By Department"
                    name="group_by_state"
                    context="{'group_by': 'state_id'}"
                />
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_l10n_py_neighborhood" model="ir.actions.act_window">
        <field name="name">Neighborhoods</field>
        <field name="res_model">l10n_py.neighborhood</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new neighborhood
            </p>
            <p>
                Neighborhoods are subdivisions of cities in Paraguay.
                You can create neighborhoods to better organize addresses.
            </p>
        </field>
    </record>

    <!-- Menu Item: Contacts > Settings > Localization > Neighborhoods -->
    <menuitem
        id="menu_l10n_py_neighborhood"
        name="Neighborhoods"
        parent="contacts.menu_localisation"
        action="action_l10n_py_neighborhood"
        sequence="4"
    />
</odoo>
